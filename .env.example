# Application
NODE_ENV=development
PORT=5050
# Use a MongoDB URI reachable by the process; inside Docker, localhost is the container.
MONGODB_URI=mongodb://127.0.0.1:27017/ai-engineering-operations
AGENT_RUNTIME_URL=http://127.0.0.1:8000

# Microsoft Azure
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_RESOURCE_GROUP=
FOUNDRY_RESOURCE_NAME=
FOUNDRY_PROJECT_NAME=

# Microsoft Foundry
FOUNDRY_PROJECT_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_EMBEDDING_DEPLOYMENT=

# Azure AI Search
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=

# GitHub
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPOSITORY=
GITHUB_DEFAULT_BRANCH=main

# Durable investigations reconcile the authoritative incident lifecycle.
# Generate a random token of at least 32 characters; transmit only over loopback or HTTPS.
OPERATIONS_API_TOKEN=
OPERATIONS_REVIEWER_ID=
INVESTIGATION_WORKER_ENABLED=false
# Knowledge workspace is server-scoped. Defaults to configured GitHub owner/repository.
KNOWLEDGE_WORKSPACE=
# Comma-separated exact browser origins. Production requires an explicit allowlist.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Explicit local-only legacy compatibility; production always requires authorization.
OPERATIONS_LOCAL_MODE=false

# Optional distinct local approval identity; never use frontend role claims.
OPERATIONS_ROLE=engineer
OPERATIONS_APPROVER_TOKEN=
OPERATIONS_APPROVER_ID=
OPERATIONS_SESSION_SECONDS=28800

# Pass 2 signed delivery / explicitly opt-in correlation and bounded polling
GITHUB_WEBHOOK_SECRET=
AZURE_ALERT_RELAY_TOKEN=
SIGNAL_AUTO_CREATE=false
SIGNAL_AUTO_INVESTIGATE=false
SIGNAL_AUTO_SEVERITIES=Critical,High
SIGNAL_DEDUP_MINUTES=60
GITHUB_SIGNAL_POLL_ENABLED=false
GITHUB_SIGNAL_POLL_SECONDS=300

# Exact comma-separated Azure resource IDs; metrics never query outside these scopes.
AZURE_DIAGNOSTIC_RESOURCE_IDS=
AZURE_INVESTIGATION_METRIC=
AZURE_LOG_ANALYTICS_WORKSPACE_ID=
AZURE_APPLICATION_INSIGHTS_APP_ID=

# Operator-installed Ollama embedding model. No automatic model download.
# Example when separately installed: all-minilm, dimension 384.
KNOWLEDGE_EMBEDDING_URL=http://127.0.0.1:11434
KNOWLEDGE_EMBEDDING_MODEL=
KNOWLEDGE_EMBEDDING_DIMENSION=

# Separate GitHub write identity; disabled by default.
GITHUB_WRITE_ENABLED=false
GITHUB_WRITE_TOKEN=
GITHUB_WRITE_REPOSITORIES=
GITHUB_WRITE_BASE_BRANCH=
GITHUB_WRITE_PATH_PREFIXES=
