# Application
NODE_ENV=development
PORT=5050
# Use a MongoDB URI reachable by the process; inside Docker, localhost is the container.
MONGODB_URI=mongodb://127.0.0.1:27017/ai-engineering-operations
AGENT_RUNTIME_URL=http://127.0.0.1:8000

# Microsoft Azure
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_RESOURCE_GROUP=
FOUNDRY_RESOURCE_NAME=
FOUNDRY_PROJECT_NAME=

# Microsoft Foundry
FOUNDRY_PROJECT_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_EMBEDDING_DEPLOYMENT=

# Azure AI Search
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=

# GitHub
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPOSITORY=
GITHUB_DEFAULT_BRANCH=main
